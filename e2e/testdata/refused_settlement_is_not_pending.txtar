# A settlement the facilitator refused is not paid, even when its receipt names
# a transaction. Only settlement_pending says a payment may still go through,
# and duplicate_settlement that the payment it copies may have.
#
# The facilitator refuses with a hash when a block executed the payment and
# aborted it, as broadcast_failed. Upstream's Go middleware blanks that hash
# for every reason but settlement_pending, while a seller on @x402/core's
# TypeScript server passes it on. refusedSettlement in seller.json has
# x402seller answer the paid request the way that seller does.
adduser seller

gnoland start

x402facilitator
x402seller seller.json $seller_user_addr

! exec node $X402_EXAMPLE_BUYER

# Withheld, refused for the reason the receipt names, and not pending.
! stdout 'sunny'
! stdout 'may still go through'
stdout 'not paid \(status 402\): broadcast_failed; tx fa01716b171e58dfdc84b5075017a9d1ac20b0d745ed75627f3f80effa14317e'

-- seller.json --
{
  "route": "GET /weather",
  "price": { "asset": "ugnot", "amount": "250000" },
  "description": "Weather data",
  "mimeType": "application/json",
  "body": {
    "location": "Paris",
    "forecast": "sunny",
    "celsius": 24
  },
  "refusedSettlement": {
    "errorReason": "broadcast_failed",
    "errorMessage": "a block executed the payment and aborted it",
    "payer": "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5",
    "transaction": "fa01716b171e58dfdc84b5075017a9d1ac20b0d745ed75627f3f80effa14317e"
  }
}
